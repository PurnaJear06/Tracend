---
/* Short pages: privacy, terms, and the pages the waitlist emails link to. No motion
   library; the same tokens, type and header as the landing page. */
import Base from './Base.astro';
import Mark from '../components/Mark.astro';

interface Props { title: string; description: string; noindex?: boolean }
const { title, description, noindex = false } = Astro.props;
---
<Base title={title} description={description} noindex={noindex}>
  <a class="skip" href="#main">Skip to content</a>
  <header class="nav" aria-label="Site">
    <a class="brand" href="/" aria-label="Tracend home"><Mark /><span translate="no">Tracend</span></a>
    <a class="nav-cta" href="/#join">Join the beta</a>
  </header>
  <main id="main" class="doc wrap">
    <slot />
  </main>
  <footer class="foot wrap"><span>&copy; 2026 Tracend</span><nav class="foot-links" aria-label="Legal"><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><a href="/beta-terms/">Beta terms</a></nav></footer>
</Base>
