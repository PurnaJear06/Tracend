# Public build settings. None of these is secret: they end up in the page.
# Local development reads .env.development. Production builds in GitHub Actions
# (.github/workflows/site-deploy.yml) take them from repository variables.

# Base URL of the Supabase Edge Functions that run the waitlist.
PUBLIC_WAITLIST_API=https://qsfzzsjenopqqqhvpyaw.supabase.co/functions/v1
# Cloudflare Turnstile site key for the site's domain (Cloudflare dashboard > Turnstile).
PUBLIC_TURNSTILE_SITE_KEY=
# Address shown on the privacy and terms pages for questions and data requests.
PUBLIC_CONTACT_EMAIL=
# The site's public address, used for link previews. Set by site-deploy.yml.
PUBLIC_SITE_URL=https://tracend.pages.dev
